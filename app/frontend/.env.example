# Base URL of the Spring Boot API, inlined into the browser bundle at BUILD time (next build).
# Leave EMPTY when a reverse proxy (NGINX / Gateway API) serves the frontend and forwards /api/* to Spring Boot.
# Use a full URL only if the API lives on another origin, e.g. NEXT_PUBLIC_API_URL=http://192.168.160.60:8080
NEXT_PUBLIC_API_URL=

# Development only (npm run dev): forward /api/* to a locally running API
# API_PROXY_TARGET=http://localhost:8080
