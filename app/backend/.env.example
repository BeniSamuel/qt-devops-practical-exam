# Copy to .env for local development:   cp .env.example .env
# The API reads .env from its working directory (the backend/ folder). Variables set in the real
# environment (docker compose "environment:", Kubernetes env/ConfigMap/Secret) take precedence.
# Format: KEY=value, one per line, no quotes, no "export".

# HTTP port of the Spring Boot API
PORT=8080

# PostgreSQL connection (Spring Boot maps these env vars to spring.datasource.*)
#   docker compose: jdbc:postgresql://postgres:5432/diary
#   kubernetes:     jdbc:postgresql://postgres.<namespace>.svc.cluster.local:5432/diary
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/diary
SPRING_DATASOURCE_USERNAME=diary
SPRING_DATASOURCE_PASSWORD=change-me

# REQUIRED — HMAC secret used to sign JWTs (min. 32 characters). Generate: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars
# Token lifetime in minutes
JWT_EXPIRATION_MINUTES=1440

# Redis cache (optional: if Redis is unreachable the API keeps working and reads from PostgreSQL)
#   docker compose: REDIS_HOST=redis      kubernetes: REDIS_HOST=redis.<namespace>.svc.cluster.local
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me
# How long cached values live (Spring duration: 30s, 10m, 1h)
CACHE_STATS_TTL=10m
CACHE_ENTRY_TTL=30m
# Set to "none" to disable caching entirely
CACHE_TYPE=redis

# Comma-separated browser origins allowed to call the API directly (patterns such as http://*:3000 or * are allowed).
# Not needed when NGINX serves the frontend and the API on the same origin.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Create the test accounts and sample entries on the first start (empty database)
SEED_ENABLED=true

# Optional JVM tuning, e.g. to keep the heap inside a container memory limit
# JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75
