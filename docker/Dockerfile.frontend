FROM node:20-alpine AS dependencies
WORKDIR /build
COPY app/frontend/package.json app/frontend/package-lock.json ./
RUN npm ci

FROM node:20-alpine AS build
WORKDIR /build
COPY --from=dependencies /build/node_modules ./node_modules
COPY app/frontend/ ./
# This value is embedded in the browser bundle. Keep it empty behind NGINX.
ARG NEXT_PUBLIC_API_URL=""
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
RUN npm run build

FROM node:20-alpine AS runtime
ENV NODE_ENV=production \
    HOSTNAME=0.0.0.0 \
    PORT=3000
WORKDIR /app
COPY --from=build --chown=node:node /build/.next/standalone ./
COPY --from=build --chown=node:node /build/.next/static ./.next/static
COPY --from=build --chown=node:node /build/public ./public
USER node
EXPOSE 3000
CMD ["node", "server.js"]
